// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id            String   @id @default(cuid())
  nome          String   @db.VarChar(120)
  administrador Boolean  @default(false)
  email         String   @unique @db.VarChar(180)
  senha         String   @db.VarChar(255)
  criadoEm      DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @db.Timestamptz(3)

  frequencias Frequencia[]
  avaliacoes  Avaliacao[]
}

model Matricula {
  id           String   @id @default(cuid())
  nome         String   @db.VarChar(120)
  matricula    String   @unique @db.VarChar(30)
  cpf          String   @unique @db.Char(11)
  /// Foto do aluno, guardada no próprio banco e servida por /api/alunos/[id]/foto.
  /// A imagem é redimensionada no navegador antes do envio.
  foto         Bytes?
  fotoTipo     String?  @db.VarChar(40)
  fotoEnviadaEm DateTime? @db.Timestamptz(3)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  frequencias Frequencia[]
  avaliacoes  Avaliacao[]

  @@index([nome])
}

model Frequencia {
  id            String    @id @default(cuid())
  alunoId       String
  aluno         Matricula @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  preceptorId   String
  preceptor     Usuario   @relation(fields: [preceptorId], references: [id], onDelete: Restrict)
  dataEnvio     DateTime  @default(now()) @db.Timestamptz(3)
  ip            String    @db.VarChar(45)
  browser       String    @db.VarChar(120)
  os            String    @db.VarChar(120)
  dispositivo   String    @db.VarChar(120)
  dataReferente DateTime  @db.Date
  horarioInicio String    @db.VarChar(5)
  horarioFim    String    @db.VarChar(5)
  cargaHoraria  Int       @db.SmallInt

  @@index([alunoId, dataReferente])
  @@index([preceptorId])
}

/// Área de estágio na qual o aluno é avaliado. Cadastrada pelo administrador.
model Area {
  id           String   @id @default(cuid())
  nome         String   @unique @db.VarChar(120)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  avaliacoes Avaliacao[]
}

/// Avaliação de um aluno, em uma área, por um preceptor. Guarda apenas a nota
/// resultante: a lista de competências vive em src/lib/competencias.ts e a
/// média delas é calculada no envio do formulário.
model Avaliacao {
  id          String    @id @default(cuid())
  alunoId     String
  aluno       Matricula @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  areaId      String
  area        Area      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  preceptorId String
  preceptor   Usuario   @relation(fields: [preceptorId], references: [id], onDelete: Restrict)
  nota        Decimal   @db.Decimal(5, 2)
  dataEnvio   DateTime  @default(now()) @db.Timestamptz(3)
  ip          String    @db.VarChar(45)
  browser     String    @db.VarChar(120)
  os          String    @db.VarChar(120)
  dispositivo String    @db.VarChar(120)

  @@unique([alunoId, areaId, preceptorId])
  @@index([alunoId])
  @@index([areaId])
  @@index([preceptorId])
}
