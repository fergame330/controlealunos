// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id            String   @id @default(cuid())
  nome          String   @db.VarChar(120)
  administrador Boolean  @default(false)
  email         String   @unique @db.VarChar(180)
  senha         String   @db.VarChar(255)
  criadoEm      DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @db.Timestamptz(3)

  frequencias Frequencia[]
  avaliacoes  Avaliacao[]
}

model Matricula {
  id           String   @id @default(cuid())
  nome         String   @db.VarChar(120)
  matricula    String   @unique @db.VarChar(30)
  cpf          String   @unique @db.Char(11)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  frequencias Frequencia[]
  avaliacoes  Avaliacao[]

  @@index([nome])
}

model Frequencia {
  id            String    @id @default(cuid())
  alunoId       String
  aluno         Matricula @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  preceptorId   String
  preceptor     Usuario   @relation(fields: [preceptorId], references: [id], onDelete: Restrict)
  dataEnvio     DateTime  @default(now()) @db.Timestamptz(3)
  ip            String    @db.VarChar(45)
  browser       String    @db.VarChar(120)
  os            String    @db.VarChar(120)
  dispositivo   String    @db.VarChar(120)
  dataReferente DateTime  @db.Date
  horarioInicio String    @db.VarChar(5)
  horarioFim    String    @db.VarChar(5)
  cargaHoraria  Int       @db.SmallInt

  @@index([alunoId, dataReferente])
  @@index([preceptorId])
}

/// Área de estágio na qual o aluno é avaliado. Cadastrada pelo administrador.
model Area {
  id           String   @id @default(cuid())
  nome         String   @unique @db.VarChar(120)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  avaliacoes Avaliacao[]
}

/// Lista fixa de competências avaliadas, agrupada por bloco. Populada pelo seed.
model Competencia {
  id    String @id @default(cuid())
  grupo String @db.VarChar(60)
  nome  String @unique @db.VarChar(160)
  ordem Int    @db.SmallInt

  pontuacoes Pontuacao[]

  @@index([ordem])
}

/// Avaliação de um aluno, em uma área, por um preceptor. Cada preceptor tem uma
/// avaliação por área; a nota da área é a média das avaliações dos preceptores.
model Avaliacao {
  id          String    @id @default(cuid())
  alunoId     String
  aluno       Matricula @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  areaId      String
  area        Area      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  preceptorId String
  preceptor   Usuario   @relation(fields: [preceptorId], references: [id], onDelete: Restrict)
  dataEnvio   DateTime  @default(now()) @db.Timestamptz(3)
  ip          String    @db.VarChar(45)
  browser     String    @db.VarChar(120)
  os          String    @db.VarChar(120)
  dispositivo String    @db.VarChar(120)

  pontuacoes Pontuacao[]

  @@unique([alunoId, areaId, preceptorId])
  @@index([alunoId])
  @@index([areaId])
  @@index([preceptorId])
}

/// Nota de uma competência dentro de uma avaliação. Todas valem o mesmo:
/// não há peso, a nota da avaliação é a média aritmética das pontuações.
model Pontuacao {
  id            String      @id @default(cuid())
  avaliacaoId   String
  avaliacao     Avaliacao   @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  competenciaId String
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Restrict)
  valor         Decimal     @db.Decimal(5, 2)

  @@unique([avaliacaoId, competenciaId])
  @@index([avaliacaoId])
}
